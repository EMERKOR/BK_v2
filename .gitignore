# Intermediate generated data (rebuilds quickly from RAW_*)
data/clean/
data/datasets/
data/features/
data/predictions/
data/backtests/
data/profiles/

# v3 canonical generated outputs (reproducible via `python3 -m ball_knower_v3.canonical.build_all`)
# The provenance registry (snapshots.json) and the frozen source snapshot (_sources/) stay tracked.
data/v3/canonical/*.parquet

# v3 Phase 2A frozen raw player sources (reproducible from the recorded URLs+hashes in
# audit_v3_player_sources/manifests/). Manifests, reports, scripts, and tests stay tracked.
data/v3/raw_player_sources/

# v3 feature-layer generated outputs (reproducible). The feature-build registry
# (feature_registry.json) stays tracked; parquet outputs and test artifacts do not.
data/v3/features/*.parquet
data/v3/features/_test_inputs/

# v3 Phase 3A local/paid market archives and reproducible normalized artifacts.
# Versioned event mappings, ingestion manifests, contracts, and synthetic test
# fixtures remain trackable; raw vendor payloads and generated quote rows do not.
data/v3/market/raw/
data/v3/market/normalized/
data/v3/evaluation/predictions/
